---
import BaseLayout from '../../layouts/BaseLayout.astro';
import workoutsData from '../../data/workouts.json';
import {
  type Workout,
  SITE_CONFIG,
  computeWorkoutStats,
  formatIntervalDuration,
  resolveAffiliateUrl,
  buildExercisePlanJsonLd,
  buildBreadcrumbJsonLd,
  getRelatedWorkouts,
} from '../../config/site';

export async function getStaticPaths() {
  const workouts = workoutsData as Workout[];
  return workouts.map((workout) => ({
    params: { slug: workout.slug },
    props: { workout },
  }));
}

interface Props {
  workout: Workout;
}

const { workout } = Astro.props;
const allWorkouts = workoutsData as Workout[];
const stats = computeWorkoutStats(workout);
const canonicalPath = `/workouts/${workout.slug}`;
const canonicalUrl = new URL(canonicalPath, SITE_CONFIG.url).toString();
const affiliateHref = resolveAffiliateUrl(workout.recommendedMachine.affiliateUrl, workout.slug);
const relatedWorkouts = getRelatedWorkouts(workout.slug, allWorkouts, 3);

const jsonLdSchemas = [
  buildExercisePlanJsonLd(workout, canonicalUrl),
  buildBreadcrumbJsonLd(workout, canonicalUrl),
];

const difficultyBadgeColor =
  workout.difficulty === 'Beginner'
    ? 'bg-sky-950/80 text-sky-300 border-sky-800/70'
    : workout.difficulty === 'Intermediate'
      ? 'bg-amber-950/80 text-amber-300 border-amber-800/70'
      : 'bg-rose-950/80 text-rose-300 border-rose-800/70';
---

<BaseLayout
  title={workout.title}
  description={workout.description}
  canonicalPath={canonicalPath}
  ogType="article"
  jsonLd={jsonLdSchemas}
>
  <div class="max-w-4xl mx-auto px-4 py-8">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="Breadcrumb" class="mb-5 flex items-center gap-2 text-xs font-medium text-slate-400">
      <a href="/" class="text-emerald-400 hover:text-emerald-300 font-semibold inline-flex items-center gap-1 transition">
        &larr; Back to all workouts
      </a>
      <span class="text-slate-600">/</span>
      <span class="text-slate-400">{workout.difficulty}</span>
      <span class="text-slate-600">/</span>
      <span class="text-slate-300 truncate max-w-[220px] sm:max-w-none">{workout.title}</span>
    </nav>

    <!-- Workout Header -->
    <header class="mb-8">
      <div class="flex flex-wrap gap-2 mb-3">
        <span class="px-2.5 py-1 text-xs font-semibold rounded-md bg-emerald-950/80 text-emerald-400 border border-emerald-800">
          {workout.targetGoal}
        </span>
        <span class={`px-2.5 py-1 text-xs font-semibold rounded-md border ${difficultyBadgeColor}`}>
          {workout.difficulty}
        </span>
        <span class="px-2.5 py-1 text-xs font-semibold rounded-md bg-slate-800 text-slate-300 border border-slate-700">
          {workout.durationMinutes} Minutes
        </span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        {workout.title}
      </h1>
      <p class="text-slate-400 mt-2 text-base leading-relaxed">
        {workout.description}
      </p>
    </header>

    <!-- Workout Specs Banner -->
    <div
      data-testid="workout-specs-banner"
      class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 p-4 rounded-xl bg-slate-900 border border-slate-800 mb-8 text-center"
    >
      <div class="p-2 rounded-lg bg-slate-950/50">
        <p class="text-[11px] uppercase text-slate-500 font-semibold tracking-wider">Duration</p>
        <p class="text-lg font-bold text-white mt-1">{workout.durationMinutes}m</p>
      </div>
      <div class="p-2 rounded-lg bg-slate-950/50">
        <p class="text-[11px] uppercase text-slate-500 font-semibold tracking-wider">Est. Burn</p>
        <p class="text-lg font-bold text-emerald-400 mt-1">{workout.caloriesBurned}</p>
      </div>
      <div class="p-2 rounded-lg bg-slate-950/50">
        <p class="text-[11px] uppercase text-slate-500 font-semibold tracking-wider">Difficulty</p>
        <p class="text-lg font-bold text-white mt-1">{workout.difficulty}</p>
      </div>
      <div class="p-2 rounded-lg bg-slate-950/50">
        <p class="text-[11px] uppercase text-slate-500 font-semibold tracking-wider">Resistance</p>
        <p class="text-lg font-bold text-white mt-1">{stats.resistanceRange}</p>
      </div>
      <div class="p-2 rounded-lg bg-slate-950/50">
        <p class="text-[11px] uppercase text-slate-500 font-semibold tracking-wider">Target RPM</p>
        <p class="text-lg font-bold text-emerald-400 mt-1">{stats.rpmRange}</p>
      </div>
      <div class="p-2 rounded-lg bg-slate-950/50">
        <p class="text-[11px] uppercase text-slate-500 font-semibold tracking-wider">Joint Impact</p>
        <p class="text-lg font-bold text-emerald-400 mt-1">Zero</p>
      </div>
    </div>

    <!-- Phone-Mounted Interactive Audio Timer Console -->
    <section
      aria-label="Live Interval Console"
      class="p-6 rounded-2xl bg-gradient-to-b from-slate-900 to-slate-900/70 border border-slate-800 mb-10 shadow-xl"
    >
      <!-- Console Top Bar -->
      <div class="flex flex-wrap items-center justify-between gap-2 mb-4 pb-3 border-b border-slate-800/80">
        <div class="flex items-center gap-2">
          <span id="status-dot" class="w-2.5 h-2.5 rounded-full bg-slate-600"></span>
          <h2 class="text-xs font-bold tracking-wider uppercase text-slate-400">
            Live Interval Console
          </h2>
          <span
            id="step-counter"
            class="text-xs font-mono px-2 py-0.5 rounded bg-slate-800 text-slate-300"
          >
            Step 1 / {workout.intervals.length}
          </span>
        </div>

        <div class="flex items-center gap-2">
          <span
            id="wake-lock-badge"
            class="text-[11px] font-mono px-2.5 py-1 rounded-md bg-slate-800/80 text-slate-400 border border-slate-700/60"
          >
            Screen Lock: Standby
          </span>
          <button
            id="mute-btn"
            type="button"
            aria-pressed="false"
            class="text-xs font-semibold px-2.5 py-1 rounded-md bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition cursor-pointer"
          >
            Sound: ON
          </button>
        </div>
      </div>

      <!-- Main Readout -->
      <div class="text-center my-2">
        <div id="interval-name" class="text-2xl sm:text-3xl font-extrabold text-white mb-3">
          Ready to Start
        </div>

        <!-- Live Target Telemetry Pills -->
        <div class="flex flex-wrap justify-center gap-2 sm:gap-3 mb-2">
          <span
            id="live-resistance"
            class="px-3 py-1 rounded-lg bg-slate-950/80 border border-slate-800 text-xs sm:text-sm font-mono text-slate-200"
          >
            Resistance: Lvl {workout.intervals[0]?.resistance}
          </span>
          <span
            id="live-incline"
            class="px-3 py-1 rounded-lg bg-slate-950/80 border border-slate-800 text-xs sm:text-sm font-mono text-slate-200"
          >
            Incline: {workout.intervals[0]?.incline}%
          </span>
          <span
            id="live-rpm"
            class="px-3 py-1 rounded-lg bg-emerald-950/60 border border-emerald-800/70 text-xs sm:text-sm font-mono text-emerald-300 font-semibold"
          >
            Target: {workout.intervals[0]?.targetRpm} RPM
          </span>
        </div>

        <!-- Giant Countdown Clock -->
        <div
          id="time-display"
          class="text-6xl sm:text-7xl font-black text-emerald-400 font-mono tracking-tighter my-4 select-none"
        >
          --:--
        </div>

        <div id="cue-note" class="text-sm sm:text-base text-slate-300 italic max-w-xl mx-auto mb-5 min-h-[1.5rem]">
          Place phone on machine holder and press start.
        </div>
      </div>

      <!-- Progress Bars (Current Interval & Total Workout) -->
      <div class="space-y-3 mb-6 max-w-2xl mx-auto">
        <div>
          <div class="flex justify-between text-xs text-slate-400 font-mono mb-1">
            <span>Current Interval Progress</span>
            <span id="interval-progress-label">0%</span>
          </div>
          <div class="w-full h-2.5 bg-slate-950 rounded-full overflow-hidden border border-slate-800">
            <div
              id="interval-progress-bar"
              class="h-full bg-emerald-500 transition-all duration-300"
              style="width: 0%"
            ></div>
          </div>
        </div>

        <div>
          <div class="flex justify-between text-xs text-slate-400 font-mono mb-1">
            <span>Total Workout Elapsed</span>
            <span id="total-remaining">Remaining: {workout.durationMinutes}:00</span>
          </div>
          <div class="w-full h-1.5 bg-slate-950 rounded-full overflow-hidden border border-slate-800">
            <div
              id="total-progress-bar"
              class="h-full bg-sky-400 transition-all duration-300"
              style="width: 0%"
            ></div>
          </div>
        </div>
      </div>

      <!-- Up Next Preview Banner -->
      <div
        id="up-next-box"
        class="max-w-2xl mx-auto mb-6 px-4 py-2.5 rounded-xl bg-slate-950/70 border border-slate-800/90 flex flex-wrap items-center justify-between gap-2 text-xs"
      >
        <span class="uppercase tracking-wider font-semibold text-slate-500">Up Next:</span>
        <span id="up-next-text" class="font-mono text-slate-300">
          {workout.intervals[1]
            ? `${workout.intervals[1].name} (${formatIntervalDuration(workout.intervals[1].durationSec)} @ Lvl ${workout.intervals[1].resistance}, ${workout.intervals[1].targetRpm} RPM)`
            : 'Workout Complete'}
        </span>
      </div>

      <!-- Primary & Stepping Controls -->
      <div class="flex flex-wrap justify-center items-center gap-3">
        <button
          id="prev-btn"
          type="button"
          class="px-4 py-3 bg-slate-800 hover:bg-slate-700 disabled:opacity-40 disabled:cursor-not-allowed text-slate-200 font-semibold rounded-xl text-sm transition cursor-pointer"
        >
          &larr; Prev Step
        </button>
        <button
          id="start-btn"
          type="button"
          class="px-7 py-3 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-extrabold rounded-xl text-base shadow-lg shadow-emerald-950/50 transition cursor-pointer"
        >
          Start Routine
        </button>
        <button
          id="next-btn"
          type="button"
          class="px-4 py-3 bg-slate-800 hover:bg-slate-700 disabled:opacity-40 disabled:cursor-not-allowed text-slate-200 font-semibold rounded-xl text-sm transition cursor-pointer"
        >
          Next Step &rarr;
        </button>
        <button
          id="reset-btn"
          type="button"
          class="px-5 py-3 bg-slate-800/80 hover:bg-slate-700 text-slate-300 font-semibold rounded-xl text-sm border border-slate-700 transition cursor-pointer"
        >
          Reset
        </button>
      </div>
    </section>

    <!-- Contextual High-Ticket Affiliate Recommendation Card -->
    <section
      data-testid="affiliate-recommendation-card"
      class="p-6 rounded-2xl bg-slate-900 border border-emerald-900/50 mb-10 shadow-lg"
    >
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-5">
        <div class="space-y-2">
          <div class="inline-flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider">
              Recommended Machine For This Routine
            </span>
          </div>
          <h3 class="text-xl sm:text-2xl font-extrabold text-white">
            {workout.recommendedMachine.name}
          </h3>
          <p class="text-slate-300 text-sm leading-relaxed">
            {workout.recommendedMachine.tagline}
          </p>

          <!-- Hardware Spec Callout Pills -->
          <div class="flex flex-wrap gap-2 pt-1">
            <span class="text-xs font-mono bg-slate-950 text-emerald-300 border border-emerald-900/60 px-2.5 py-1 rounded-md">
              Typical: {workout.recommendedMachine.priceRange}
            </span>
            {workout.recommendedMachine.specs && (
              <>
                <span class="text-xs font-mono bg-slate-800/90 text-slate-300 px-2.5 py-1 rounded-md">
                  Flywheel: {workout.recommendedMachine.specs.flywheel}
                </span>
                <span class="text-xs font-mono bg-slate-800/90 text-slate-300 px-2.5 py-1 rounded-md">
                  Stride: {workout.recommendedMachine.specs.strideLength}
                </span>
                <span class="text-xs font-mono bg-slate-800/90 text-slate-300 px-2.5 py-1 rounded-md">
                  Incline: {workout.recommendedMachine.specs.maxIncline}
                </span>
              </>
            )}
          </div>
        </div>

        <div class="flex flex-col gap-2 shrink-0 w-full sm:w-auto">
          <a
            href={affiliateHref}
            target="_blank"
            rel="nofollow sponsored"
            class="px-6 py-3.5 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-extrabold rounded-xl text-center text-sm transition shadow-md shadow-emerald-950/50"
          >
            Check Best Price &rarr;
          </a>
          {workout.recommendedMachine.slug && (
            <a
              href={`/equipment/${workout.recommendedMachine.slug}`}
              class="text-xs font-semibold text-center text-slate-400 hover:text-emerald-400 py-1 transition"
            >
              Read Full In-Depth Review &rarr;
            </a>
          )}
        </div>
      </div>
    </section>

    <!-- Detailed Interval Breakdown Table -->
    <section class="mb-12">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
        <h2 class="text-2xl font-bold text-white">Interval Schedule</h2>
        <p class="text-xs text-slate-400">
          Tip: Click any interval row below to jump the console directly to that stage.
        </p>
      </div>
      <div class="overflow-x-auto rounded-xl border border-slate-800">
        <table class="w-full text-left text-sm">
          <thead class="bg-slate-900 text-slate-400 uppercase font-semibold text-xs border-b border-slate-800">
            <tr>
              <th class="p-3 w-12">#</th>
              <th class="p-3">Interval</th>
              <th class="p-3">Time</th>
              <th class="p-3">Resistance</th>
              <th class="p-3">Incline</th>
              <th class="p-3">Target RPM</th>
              <th class="p-3">Instructions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800 bg-slate-950/40">
            {workout.intervals.map((step, idx) => (
              <tr
                data-interval-row={idx}
                class="hover:bg-slate-900/50 transition cursor-pointer"
                title={`Jump to ${step.name}`}
              >
                <td class="p-3 font-mono text-xs text-slate-500">{idx + 1}</td>
                <td class="p-3 font-semibold text-white">{step.name}</td>
                <td class="p-3 font-mono text-emerald-400 whitespace-nowrap">
                  {formatIntervalDuration(step.durationSec)}
                </td>
                <td class="p-3 font-mono whitespace-nowrap">Lvl {step.resistance}</td>
                <td class="p-3 font-mono whitespace-nowrap">{step.incline}%</td>
                <td class="p-3 font-mono whitespace-nowrap">{step.targetRpm}</td>
                <td class="p-3 text-slate-400">{step.notes}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Related Workouts Internal Link Mesh -->
    {relatedWorkouts.length > 0 && (
      <section class="border-t border-slate-900 pt-10">
        <div class="flex items-center justify-between mb-5">
          <h2 class="text-xl font-bold text-white">Related Elliptical Routines</h2>
          <a href="/" class="text-xs font-semibold text-emerald-400 hover:text-emerald-300">
            View All {allWorkouts.length} Workouts &rarr;
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {relatedWorkouts.map((related) => (
            <a
              href={`/workouts/${related.slug}`}
              class="group p-4 rounded-xl bg-slate-900/70 border border-slate-800 hover:border-emerald-500/50 transition flex flex-col justify-between"
            >
              <div>
                <div class="flex items-center gap-2 text-xs text-slate-400 mb-2">
                  <span class="font-semibold text-emerald-400">{related.durationMinutes}m</span>
                  <span>&bull;</span>
                  <span>{related.difficulty}</span>
                </div>
                <h3 class="font-bold text-white group-hover:text-emerald-400 transition text-sm leading-snug">
                  {related.title}
                </h3>
              </div>
              <p class="text-xs text-slate-400 mt-3 font-mono">
                {related.caloriesBurned} &middot; {related.targetGoal}
              </p>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>

  <!-- Interval Timer Logic with Web Audio API, Interval Stepping, & Screen WakeLock -->
  <script define:vars={{ intervals: workout.intervals }}>
    let currentIndex = 0;
    let timeRemaining = intervals[0]?.durationSec || 0;
    let timerId = null;
    let wakeLock = null;
    let isMuted = false;
    let audioCtx = null;

    const totalWorkoutSeconds = intervals.reduce((sum, step) => sum + step.durationSec, 0);

    function getAudioContext() {
      if (!audioCtx) {
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        if (AudioContextClass) {
          audioCtx = new AudioContextClass();
        }
      }
      return audioCtx;
    }

    function beep(freq = 600, duration = 0.15) {
      if (isMuted) return;
      try {
        const ctx = getAudioContext();
        if (!ctx) return;
        if (ctx.state === 'suspended') ctx.resume();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.frequency.value = freq;
        osc.start();
        gain.gain.exponentialRampToValueAtTime(0.00001, ctx.currentTime + duration);
        osc.stop(ctx.currentTime + duration);
      } catch (err) {
        console.warn('Web Audio beep skipped:', err);
      }
    }

    const wakeLockBadgeEl = document.getElementById('wake-lock-badge');

    function updateWakeLockBadge(active) {
      if (!wakeLockBadgeEl) return;
      if (active) {
        wakeLockBadgeEl.textContent = 'Screen Lock: Active';
        wakeLockBadgeEl.className =
          'text-[11px] font-mono px-2.5 py-1 rounded-md bg-emerald-950/80 text-emerald-300 border border-emerald-800';
      } else {
        wakeLockBadgeEl.textContent = 'Screen Lock: Standby';
        wakeLockBadgeEl.className =
          'text-[11px] font-mono px-2.5 py-1 rounded-md bg-slate-800/80 text-slate-400 border border-slate-700/60';
      }
    }

    async function requestWakeLock() {
      try {
        if ('wakeLock' in navigator) {
          wakeLock = await navigator.wakeLock.request('screen');
          updateWakeLockBadge(true);
          wakeLock.addEventListener('release', () => {
            updateWakeLockBadge(false);
          });
        }
      } catch (err) {
        console.warn('Wake Lock request failed:', err);
        updateWakeLockBadge(false);
      }
    }

    async function releaseWakeLock() {
      if (wakeLock) {
        try {
          await wakeLock.release();
        } catch {
          // ignore release errors
        }
        wakeLock = null;
      }
      updateWakeLockBadge(false);
    }

    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible' && timerId !== null) {
        requestWakeLock();
      }
    });

    const intervalNameEl = document.getElementById('interval-name');
    const timeDisplayEl = document.getElementById('time-display');
    const cueNoteEl = document.getElementById('cue-note');
    const stepCounterEl = document.getElementById('step-counter');
    const liveResistanceEl = document.getElementById('live-resistance');
    const liveInclineEl = document.getElementById('live-incline');
    const liveRpmEl = document.getElementById('live-rpm');
    const intervalProgressBarEl = document.getElementById('interval-progress-bar');
    const intervalProgressLabelEl = document.getElementById('interval-progress-label');
    const totalProgressBarEl = document.getElementById('total-progress-bar');
    const totalRemainingEl = document.getElementById('total-remaining');
    const upNextTextEl = document.getElementById('up-next-text');
    const statusDotEl = document.getElementById('status-dot');

    const startBtn = document.getElementById('start-btn');
    const resetBtn = document.getElementById('reset-btn');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');
    const muteBtn = document.getElementById('mute-btn');
    const tableRows = document.querySelectorAll('[data-interval-row]');

    function formatClock(seconds) {
      const safe = Math.max(0, seconds);
      const mins = Math.floor(safe / 60).toString().padStart(2, '0');
      const secs = (safe % 60).toString().padStart(2, '0');
      return `${mins}:${secs}`;
    }

    function formatShortDuration(durationSec) {
      const m = Math.floor(durationSec / 60);
      const s = durationSec % 60;
      if (m > 0 && s > 0) return `${m}m ${s}s`;
      if (m > 0) return `${m}m`;
      return `${s}s`;
    }

    function highlightActiveRow() {
      tableRows.forEach((row, idx) => {
        if (idx === currentIndex) {
          row.classList.add('bg-emerald-950/40', 'border-l-4', 'border-l-emerald-400');
        } else {
          row.classList.remove('bg-emerald-950/40', 'border-l-4', 'border-l-emerald-400');
        }
      });
    }

    function updateDisplay() {
      const current = intervals[currentIndex];
      if (!current) return;

      intervalNameEl.textContent = `${current.name} (Resistance ${current.resistance} | ${current.targetRpm} RPM)`;
      cueNoteEl.textContent = current.notes;
      timeDisplayEl.textContent = formatClock(timeRemaining);

      if (stepCounterEl) {
        stepCounterEl.textContent = `Step ${currentIndex + 1} / ${intervals.length}`;
      }
      if (liveResistanceEl) {
        liveResistanceEl.textContent = `Resistance: Lvl ${current.resistance}`;
      }
      if (liveInclineEl) {
        liveInclineEl.textContent = `Incline: ${current.incline}%`;
      }
      if (liveRpmEl) {
        liveRpmEl.textContent = `Target: ${current.targetRpm} RPM`;
      }

      // Interval Progress
      const intervalElapsed = current.durationSec - timeRemaining;
      const intervalPct = Math.min(100, Math.max(0, Math.round((intervalElapsed / current.durationSec) * 100)));
      if (intervalProgressBarEl) intervalProgressBarEl.style.width = `${intervalPct}%`;
      if (intervalProgressLabelEl) intervalProgressLabelEl.textContent = `${intervalPct}%`;

      // Total Progress
      const completedBefore = intervals
        .slice(0, currentIndex)
        .reduce((sum, step) => sum + step.durationSec, 0);
      const totalElapsed = completedBefore + intervalElapsed;
      const totalRemaining = Math.max(0, totalWorkoutSeconds - totalElapsed);
      const totalPct = Math.min(100, Math.max(0, Math.round((totalElapsed / totalWorkoutSeconds) * 100)));
      if (totalProgressBarEl) totalProgressBarEl.style.width = `${totalPct}%`;
      if (totalRemainingEl) totalRemainingEl.textContent = `Remaining: ${formatClock(totalRemaining)}`;

      // Up Next Preview
      const nextStep = intervals[currentIndex + 1];
      if (upNextTextEl) {
        upNextTextEl.textContent = nextStep
          ? `${nextStep.name} (${formatShortDuration(nextStep.durationSec)} @ Lvl ${nextStep.resistance}, ${nextStep.targetRpm} RPM)`
          : 'Final Interval — Cooldown / Finish Ahead';
      }

      if (prevBtn) prevBtn.disabled = currentIndex === 0;
      if (nextBtn) nextBtn.disabled = currentIndex >= intervals.length - 1;

      highlightActiveRow();
    }

    function setRunningIndicator(running) {
      if (!statusDotEl) return;
      statusDotEl.className = running
        ? 'w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse'
        : 'w-2.5 h-2.5 rounded-full bg-slate-600';
    }

    function tick() {
      if (timeRemaining <= 3 && timeRemaining > 0) {
        beep(520, 0.1); // Countdown pip
      }

      if (timeRemaining <= 0) {
        beep(880, 0.35); // Interval change alert
        currentIndex++;
        if (currentIndex >= intervals.length) {
          clearInterval(timerId);
          timerId = null;
          setRunningIndicator(false);
          intervalNameEl.textContent = 'Workout Complete!';
          timeDisplayEl.textContent = '00:00';
          cueNoteEl.textContent = 'Outstanding work. Cool down and rehydrate.';
          if (intervalProgressBarEl) intervalProgressBarEl.style.width = '100%';
          if (intervalProgressLabelEl) intervalProgressLabelEl.textContent = '100%';
          if (totalProgressBarEl) totalProgressBarEl.style.width = '100%';
          if (totalRemainingEl) totalRemainingEl.textContent = 'Remaining: 00:00';
          startBtn.textContent = 'Start Routine';
          releaseWakeLock();
          return;
        }
        timeRemaining = intervals[currentIndex].durationSec;
      } else {
        timeRemaining--;
      }
      updateDisplay();
    }

    function jumpToInterval(index) {
      if (index < 0 || index >= intervals.length) return;
      currentIndex = index;
      timeRemaining = intervals[currentIndex].durationSec;
      updateDisplay();
    }

    startBtn.addEventListener('click', () => {
      if (timerId) {
        clearInterval(timerId);
        timerId = null;
        startBtn.textContent = 'Resume';
        setRunningIndicator(false);
      } else {
        if (currentIndex >= intervals.length) {
          currentIndex = 0;
          timeRemaining = intervals[0]?.durationSec || 0;
        }
        requestWakeLock();
        timerId = setInterval(tick, 1000);
        startBtn.textContent = 'Pause';
        setRunningIndicator(true);
      }
    });

    resetBtn.addEventListener('click', () => {
      clearInterval(timerId);
      timerId = null;
      currentIndex = 0;
      timeRemaining = intervals[0]?.durationSec || 0;
      startBtn.textContent = 'Start Routine';
      setRunningIndicator(false);
      updateDisplay();
      releaseWakeLock();
    });

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        if (currentIndex > 0) {
          jumpToInterval(currentIndex - 1);
        }
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        if (currentIndex < intervals.length - 1) {
          jumpToInterval(currentIndex + 1);
        }
      });
    }

    if (muteBtn) {
      muteBtn.addEventListener('click', () => {
        isMuted = !isMuted;
        muteBtn.setAttribute('aria-pressed', String(isMuted));
        muteBtn.textContent = isMuted ? 'Sound: MUTED' : 'Sound: ON';
        muteBtn.className = isMuted
          ? 'text-xs font-semibold px-2.5 py-1 rounded-md bg-rose-950/80 hover:bg-rose-900 text-rose-300 border border-rose-800 transition cursor-pointer'
          : 'text-xs font-semibold px-2.5 py-1 rounded-md bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition cursor-pointer';
      });
    }

    tableRows.forEach((row, idx) => {
      row.addEventListener('click', () => {
        jumpToInterval(idx);
      });
    });

    updateDisplay();
  </script>
</BaseLayout>
